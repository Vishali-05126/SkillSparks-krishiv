generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  MENTOR
  BOTH
}

enum PostType {
  HIGHLIGHT
  POST
  TALENT
  MEME
}

enum SwapStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum SessionType {
  ONE_TO_ONE
  GROUP
}

enum SessionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ProjectLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id                       String               @id @default(cuid())
  name                     String
  email                    String               @unique
  passwordHash             String?
  avatarUrl                String?
  coverUrl                 String?
  bio                      String?
  headline                 String?
  gender                   String?
  dateOfBirth              DateTime?
  city                     String?
  country                  String?
  timezone                 String?
  languages                String[]             @default([])
  interests                String[]             @default([])
  personalityType          String?
  socialStyle              String?
  learnerType              String?
  phone                    String?
  phoneVerified            Boolean              @default(false)
  education                Json?
  experience               Json?
  certifications           Json?
  achievements             Json?
  mentorSettings           Json?
  socialLinks              Json?
  privacy                  Json?
  profileCompletionPercent Int                  @default(0)
  role                     UserRole             @default(BOTH)
  createdAt                DateTime             @default(now())
  skillsHave               UserSkillHave[]
  skillsWant               UserSkillWant[]
  posts                    Post[]
  proofs                   Proof[]
  swapsAsA                 Swap[]               @relation("swapA")
  swapsAsB                 Swap[]               @relation("swapB")
  sessionsMentored         Session[]            @relation("mentor")
  sessionsJoined           SessionParticipant[]
  teamsCreated             Team[]               @relation("teamCreator")
  teamMemberships          TeamMember[]
  roomMessages             RoomMessage[]
  payments                 Payment[]
  accounts                 Account[]
  sessions                 AuthSession[]
  hobbies                  Hobby[]
  interestsDetailed        Interest[]
  connectionRequestsSent   ConnectionRequest[] @relation("connectionSender")
  connectionRequestsReceived ConnectionRequest[] @relation("connectionRecipient")
}

model ConnectionRequest {
  id          String           @id @default(cuid())
  senderId    String
  recipientId String
  message     String?          @db.VarChar(500)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  sender      User             @relation("connectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User             @relation("connectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
  @@index([senderId, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Skill {
  id             String          @id @default(cuid())
  name           String          @unique
  category       String?
  usersHave      UserSkillHave[]
  usersWant      UserSkillWant[]
  swapsOffered   Swap[]          @relation("offeredSkill")
  swapsRequested Swap[]          @relation("requestedSkill")
}

model Hobby {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Interest {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model UserSkillHave {
  userId      String
  skillId     String
  proficiency Int    @default(1)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model UserSkillWant {
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  type      PostType
  mediaUrl  String?
  caption   String
  tags      String[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Proof {
  id         String  @id @default(cuid())
  userId     String
  title      String
  url        String
  verified   Boolean @default(false)
  reviewedBy String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Swap {
  id               String     @id @default(cuid())
  userAId          String
  userBId          String
  skillOfferedId   String
  skillRequestedId String
  status           SwapStatus @default(PENDING)
  isPaid           Boolean    @default(false)
  createdAt        DateTime   @default(now())
  userA            User       @relation("swapA", fields: [userAId], references: [id], onDelete: Cascade)
  userB            User       @relation("swapB", fields: [userBId], references: [id], onDelete: Cascade)
  skillOffered     Skill      @relation("offeredSkill", fields: [skillOfferedId], references: [id])
  skillRequested   Skill      @relation("requestedSkill", fields: [skillRequestedId], references: [id])
}

model Session {
  id                 String               @id @default(cuid())
  mentorId           String
  type               SessionType
  scheduledAt        DateTime
  durationMins       Int
  price              Int
  status             SessionStatus        @default(PENDING)
  notesGeneratedText String?              @db.Text
  mentor             User                 @relation("mentor", fields: [mentorId], references: [id])
  participants       SessionParticipant[]
  payment            Payment?
}

model SessionParticipant {
  sessionId String
  userId    String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
}

model Team {
  id           String       @id @default(cuid())
  projectTopic String
  createdById  String
  createdAt    DateTime     @default(now())
  createdBy    User         @relation("teamCreator", fields: [createdById], references: [id])
  members      TeamMember[]
}

model TeamMember {
  teamId     String
  userId     String
  roleNeeded String
  team       Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Room {
  id          String        @id @default(cuid())
  topic       String        @unique
  description String?
  messages    RoomMessage[]
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Project {
  id            String       @id @default(cuid())
  title         String
  description   String
  level         ProjectLevel
  resourceLinks String[]
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  sessionId       String        @unique
  amount          Int
  stripePaymentId String?       @unique
  status          PaymentStatus @default(PENDING)
  user            User          @relation(fields: [userId], references: [id])
  session         Session       @relation(fields: [sessionId], references: [id])
}
